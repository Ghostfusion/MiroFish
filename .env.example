# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== 本地图谱存储配置 =====
# MiroFish 通过 graphiti_core 在进程内直连本地图数据库，不再使用 Zep Cloud。
# GRAPH_BACKEND=neo4j：需要一个可访问的 Neo4j（见 README 的启动说明）
# GRAPH_BACKEND=kuzu ：使用内嵌 Kuzu 文件库，无需任何外部服务
GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
# 仅 GRAPH_BACKEND=kuzu 时使用
#KUZU_DB_PATH=./uploads/graph.kuzu

# 向量化配置：写入图数据库的向量维度必须与这里保持一致
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIM=1024

# ===== 加速 LLM 配置（可选）=====
# 不使用加速配置时保持注释状态：只要 LLM_BOOST_API_KEY 有值，
# Reddit 平台就会改用下面这套配置，填占位符会导致模拟请求失败
#LLM_BOOST_API_KEY=your_api_key_here
#LLM_BOOST_BASE_URL=your_base_url_here
#LLM_BOOST_MODEL_NAME=your_model_name_here
